<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>experiment_runner</name>
  <version>0.1.0</version>
  <description>Experiment orchestration: dataset recording, evaluation scripts, batch runner</description>
  <maintainer email="user@example.com">User</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>ros2bag</depend>

  <exec_depend>rover_sim</exec_depend>
  <exec_depend>rover_control</exec_depend>
  <exec_depend>gt_publisher</exec_depend>
  <exec_depend>slam_launch</exec_depend>
  <exec_depend>traj_exporter</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
