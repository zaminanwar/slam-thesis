<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>slam_launch</name>
  <version>0.1.0</version>
  <description>Launch files and configs for SLAM algorithms (slam_toolbox, Cartographer)</description>
  <maintainer email="user@example.com">User</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Launch dependencies -->
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- SLAM algorithms -->
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>cartographer_ros</exec_depend>

  <!-- Bag playback -->
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>

  <!-- Robot description for static TF during bag replay -->
  <exec_depend>rover_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Live SLAM dependencies -->
  <exec_depend>rover_sim</exec_depend>
  <exec_depend>rover_control</exec_depend>
  <exec_depend>gt_publisher</exec_depend>
  <exec_depend>traj_exporter</exec_depend>
  <exec_depend>experiment_runner</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
